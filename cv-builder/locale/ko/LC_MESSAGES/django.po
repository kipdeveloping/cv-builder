msgstr "JPG, PNG 또는 WebP. 최대 5MB."

msgid "Subir foto"
msgstr "사진 업로드"

msgid "Necesitas subir una foto para poder publicar tus CVs."
msgstr "이력서를 게시하려면 사진을 업로드해야 합니다."

msgid "Bio (Quién soy)"
msgstr "자기소개"

msgid "Cuéntanos sobre ti..."
msgstr "자신에 대해 알려주세요..."

msgid "Guardar bio"
msgstr "자기소개 저장"

msgid "Mis CVs"
msgstr "내 이력서"

msgid "Sin plantilla"
msgstr "템플릿 없음"

