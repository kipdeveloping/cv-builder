msgstr "주요 분야:"

msgid "Cancelar"
msgstr "취소"

msgid "Confirmar publicación"
msgstr "게시 확인"

msgid "Quién soy"
msgstr "자기소개"

msgid "Experiencia"
msgstr "경력"

