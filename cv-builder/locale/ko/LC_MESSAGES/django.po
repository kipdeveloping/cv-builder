msgstr "직위"

msgid "Empresa"
msgstr "회사"

msgid "2020 - Presente"
msgstr "2020년 - 현재"

msgid "Descripción de tus responsabilidades..."
msgstr "담당 업무 설명..."

msgid "Agregar experiencia"
msgstr "경력 추가"

msgid "Educación"
msgstr "학력"

msgid "Título"
msgstr "학위"

msgid "Institución"
msgstr "기관"

msgid "2018"
msgstr "2018"

msgid "Agregar educación"
msgstr "학력 추가"

msgid "Habilidades"
msgstr "기술"

msgid "Python"
msgstr "Python"

msgid "JavaScript"
msgstr "JavaScript"

msgid "Agregar habilidad"
msgstr "기술 추가"

msgid "Tablón de Talentos"
msgstr "인재 게시판"

msgid "Descubre profesionales talentosos en diferentes sectores."
msgstr "다양한 분야의 재능 있는 전문가를 발견하세요."

msgid "Todos"
msgstr "전체"

msgid "Cargando..."
msgstr "로딩 중..."

msgid "No se encontraron CVs en esta categoría."
msgstr "이 카테고리에서 이력서를 찾을 수 없습니다."

