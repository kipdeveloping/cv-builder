msgstr "أدخل بريداً إلكترونياً صالحاً."

msgid "La contraseña debe contener al menos un carácter especial (!@#$%^&*(),.?\":{}|<>)."
msgstr "يجب أن تحتوي كلمة المرور على حرف خاص واحد على الأقل (!@#$%^&*(),.?\":{}|<>)."

msgid "La contraseña debe tener al menos 8 caracteres, 1 mayúscula, 1 número y 1 carácter especial."
msgstr "يجب أن تتكون كلمة المرور من 8 أحرف على الأقل، مع حرف كبير واحد ورقم واحد وحرف خاص واحد."

msgid "Mínimo 8 caracteres"
msgstr "8 أحرف على الأقل"

