msgstr "Допускаются только файлы JPG, PNG или WebP."

msgid "Tablón de talentos"
msgstr "Доска талантов"

msgid "Ya tengo cuenta"
msgstr "У меня уже есть аккаунт"

msgid "¡Cuenta creada exitosamente!"
msgstr "Аккаунт успешно создан!"

msgid "¿Listo para crear tu CV?"
msgstr "Готовы создать своё резюме?"

msgid "¿Por qué CV Builder?"
msgstr "Почему CV Builder?"

msgid "Únete a nuestra comunidad de profesionales."
msgstr "Присоединяйтесь к нашему сообществу профессионалов."

msgid "Ver todas las secciones"
msgstr "Показать все разделы"

msgid "Al menos un carácter especial (!@#$%^&*())"
msgstr "По крайней мере один специальный символ (!@#$%^&*())"

msgid "Al menos un número"
msgstr "По крайней мере одна цифра"

msgid "Al menos una letra mayúscula"
msgstr "По крайней мере одна заглавная буква"

msgid "Apellido"
msgstr "Фамилия"

msgid "Continuar"
msgstr "Продолжить"

msgid "Crea tu cuenta"
msgstr "Создайте свою учётную запись"

msgid "Cuenta"
msgstr "Учётная запись"

