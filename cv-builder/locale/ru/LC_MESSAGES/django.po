msgstr "Создавайте впечатляющие резюме с профессиональными шаблонами. Публикуйте их на доске талантов и находите возможности."

msgid "Edita directamente en la plantilla con autoguardado automático."
msgstr "Редактируйте прямо в шаблоне с автоматическим сохранением."

msgid "Editor visual"
msgstr "Визуальный редактор"

msgid "Elige entre diseños clásico, moderno y creativo para destacar tu perfil."
msgstr "Выбирайте между классическим, современным и креативным дизайном, чтобы выделить свой профиль."

msgid "Email o contraseña incorrectos."
msgstr "Неверный email или пароль."

msgid "Este email ya está registrado."
msgstr "Этот email уже зарегистрирован."

msgid "Foto actualizada correctamente."
msgstr "Фото успешно обновлено."

msgid "Has cerrado sesión correctamente."
msgstr "Вы успешно вышли из системы."

msgid "La contraseña debe contener al menos un número."
msgstr "Пароль должен содержать хотя бы одну цифру."

msgid "La contraseña debe contener al menos una letra mayúscula."
msgstr "Пароль должен содержать хотя бы одну заглавную букву."

msgid "La contraseña debe tener al menos 8 caracteres."
msgstr "Пароль должен содержать не менее 8 символов."

msgid "La foto no puede superar los 5MB."
msgstr "Фото не может превышать 5 МБ."

msgid "Las contraseñas no coinciden."
msgstr "Пароли не совпадают."

msgid "O explora el tablón como invitado"
msgstr "Или изучите доску как гость"

msgid "Por favor, corrige los errores."
msgstr "Пожалуйста, исправьте ошибки."

msgid "Publica tu CV y descubre profesionales por sector."
msgstr "Опубликуйте резюме и находите специалистов по сферам."

msgid "Seleccionar Plantilla"
msgstr "Выбрать шаблон"

msgid "Siguiente"
msgstr "Далее"

