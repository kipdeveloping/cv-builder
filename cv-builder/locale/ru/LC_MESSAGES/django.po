msgstr "Например: Веб-разработчик"

msgid "Elige tu rol"
msgstr "Выберите свою роль"

msgid "Encuentra talento para tu negocio."
msgstr "Найдите таланты для своего бизнеса."

msgid "Esta funcionalidad estará disponible próximamente."
msgstr "Эта функция будет доступна в ближайшее время."

msgid "Introduce un email válido."
msgstr "Введите действующий адрес электронной почты."

msgid "La contraseña debe contener al menos un carácter especial (!@#$%^&*(),.?\":{}|<>)."
msgstr "Пароль должен содержать хотя бы один специальный символ (!@#$%^&*(),.?\":{}|<>)."

msgid "La contraseña debe tener al menos 8 caracteres, 1 mayúscula, 1 número y 1 carácter especial."
msgstr "Пароль должен содержать не менее 8 символов: 1 заглавную букву, 1 цифру и 1 специальный символ."

msgid "Mínimo 8 caracteres"
msgstr "Минимум 8 символов"

msgid "Nombre"
msgstr "Имя"

msgid "Opcional"
msgstr "Необязательно"

msgid "Perfil profesional"
msgstr "Профессиональный профиль"

msgid "Por favor, completa este campo."
msgstr "Пожалуйста, заполните это поле."

msgid "Próximamente"
msgstr "Скоро"

msgid "Publica tu CV y encuentra oportunidades."
msgstr "Публикуйте своё резюме и находите возможности."

msgid "Registro de Trabajador"
msgstr "Регистрация работника"

msgid "Sector"
msgstr "Сфера"

msgid "Soy Empresa"
msgstr "Я компания"

msgid "Soy Trabajador"
msgstr "Я работник"

msgid "Tu nombre"
msgstr "Ваше имя"

msgid "Tus apellidos"
msgstr "Ваша фамилия"

msgid "Título profesional"
msgstr "Профессиональный титул"

msgid "Continúa con"
msgstr "Продолжить с помощью"

msgid "o con tu correo electrónico"
msgstr "или с помощью вашей электронной почты"

msgid "Regístrate con"
msgstr "Зарегистрироваться с помощью"

msgid "o crea tu cuenta con correo electrónico"
msgstr "или создайте учётную запись с помощью электронной почты"

msgid "Completa tu perfil profesional"
msgstr "Заполните свой профессиональный профиль"

msgid "Para terminar tu registro, completa tu perfil profesional."
msgstr "Чтобы завершить регистрацию, заполните свой профессиональный профиль."

msgid "Selecciona al menos un campo (título o sector) para continuar."
msgstr "Выберите хотя бы одно поле (титул или сферу), чтобы продолжить."

msgid "Debes seleccionar al menos un campo (título o sector)."
msgstr "Вы должны выбрать хотя бы одно поле (титул или сферу)."

msgid "Guardar y continuar"
msgstr "Сохранить и продолжить"
